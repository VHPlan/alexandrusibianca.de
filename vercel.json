{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/nasii", "destination": "/secret", "permanent": true },
    { "source": "/nasii/:path*", "destination": "/secret", "permanent": true }
  ],
  "headers": [
    {
      "source": "/secret(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
